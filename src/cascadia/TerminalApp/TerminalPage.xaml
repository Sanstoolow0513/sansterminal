<Page x:Class="TerminalApp.TerminalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:TerminalApp"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:mtu="using:Microsoft.Terminal.UI"
      xmlns:mux="using:Microsoft.UI.Xaml.Controls"
      Background="Transparent"
      mc:Ignorable="d">

    <Grid x:Name="Root"
          Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:TabRowControl x:Name="TabRow"
                             Grid.Row="0"
                             KeyUp="_KeyDownHandler" />

        <StackPanel x:Name="InfoBarContainer"
                    Grid.Row="1"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <mux:InfoBar x:Name="CloseOnExitInfoBar"
                         x:Uid="CloseOnExitInfoBar"
                         x:Load="False"
                         CornerRadius="0"
                         IsClosable="True"
                         IsIconVisible="True"
                         IsOpen="False"
                         Severity="Informational">
                <mux:InfoBar.ActionButton>
                    <Button x:Uid="InfoBarDismissButton"
                            Click="_CloseOnExitInfoDismissHandler" />
                </mux:InfoBar.ActionButton>
            </mux:InfoBar>
        </StackPanel>

        <!-- Tabs, workspace files, terminal and file preview share one window. -->
        <Grid x:Name="SideTabLayout"
              Grid.Row="2"
              SizeChanged="_SideTabLayoutSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideTabColumn" Width="0" />
                <ColumnDefinition x:Name="WorkspaceFilesColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="SideTabOverlay"
                  Grid.Column="0"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  Visibility="Collapsed">
                <Border x:Name="SideTabPanel"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
            </Grid>

            <Grid x:Name="WorkspaceFilesPanel"
                  Grid.Column="1"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0"
                            Margin="12,12,8,4"
                            Orientation="Horizontal">
                    <TextBlock x:Uid="WorkspaceFilesHeader"
                               FontWeight="SemiBold" />
                    <Button x:Name="WorkspaceChangeFolderButton"
                            x:Uid="WorkspaceChangeFolderButton"
                            MinWidth="0"
                            Margin="8,0,0,0"
                            Padding="4,0"
                            Click="_WorkspaceChangeFolderClick" />
                </StackPanel>
                <Grid Grid.Row="1"
                      Margin="8,0,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="WorkspaceRefreshButton"
                            x:Uid="WorkspaceRefreshButton"
                            MinWidth="0"
                            Padding="6,2"
                            Click="_WorkspaceRefreshClick" />
                    <TextBlock x:Name="WorkspacePathText"
                               Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBox x:Name="WorkspaceFileSearchBox"
                         x:Uid="WorkspaceFileSearchBox"
                         Grid.Row="2"
                         Margin="8,4,8,4"
                         TextChanged="_WorkspaceFileSearchChanged" />
                <Grid Grid.Row="3">
                    <mux:TreeView x:Name="WorkspaceFileTree"
                                  CanDragItems="False"
                                  CanReorderItems="False"
                                  ItemInvoked="_WorkspaceFileInvoked"
                                  Expanding="_WorkspaceFileExpanding"
                                  DoubleTapped="_WorkspaceFileDoubleTapped"
                                  SelectionMode="Single">
                        <mux:TreeView.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding Content}" />
                            </DataTemplate>
                        </mux:TreeView.ItemTemplate>
                    </mux:TreeView>
                    <ListView x:Name="WorkspaceFileSearchResults"
                              SelectionChanged="_WorkspaceFileSearchResultSelected"
                              DoubleTapped="_WorkspaceFileSearchResultDoubleTapped"
                              Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="WorkspaceFilesStatus"
                           Grid.Row="4"
                           Margin="12,4,8,8"
                           Opacity="0.65"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <Grid x:Name="WorkspaceContentArea"
                  Grid.Column="2"
                  SizeChanged="_WorkspaceContentSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="WorkspaceTerminalColumn" Width="*" />
                    <ColumnDefinition x:Name="WorkspaceDocumentColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="TabContent"
                      Grid.Column="0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.Background>
                        <ImageBrush />
                    </Grid.Background>
                </Grid>
                <Grid x:Name="WorkspaceDocumentPanel"
                      Grid.Column="1"
                      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="WorkspaceDocumentTopInset" Height="0" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <mux:TabView x:Name="WorkspaceDocumentTabs"
                                     IsAddTabButtonVisible="False"
                                     TabWidthMode="SizeToContent"
                                     SelectionChanged="_WorkspaceDocumentSelectionChanged"
                                     TabCloseRequested="_WorkspaceDocumentTabCloseRequested" />
                        <Button x:Name="WorkspaceDocumentMaximizeButton"
                                x:Uid="WorkspaceDocumentMaximizeButton"
                                Grid.Column="1"
                                MinWidth="0"
                                Margin="4,0"
                                Padding="8,2"
                                Click="_WorkspaceDocumentMaximizeClick" />
                        <Button x:Name="WorkspaceClosePreviewButton"
                                x:Uid="WorkspaceClosePreviewButton"
                                Grid.Column="2"
                                MinWidth="0"
                                Margin="0,0,8,0"
                                Padding="8,2"
                                Click="_WorkspaceClosePreviewClick" />
                    </Grid>
                    <RichEditBox x:Name="WorkspaceDocumentEditor"
                                 Grid.Row="2"
                                 Margin="8,0,8,4"
                                 FontFamily="Cascadia Mono"
                                 IsReadOnly="True"
                                 SelectionChanged="_WorkspaceDocumentCaretChanged"
                                 TextWrapping="NoWrap" />
                    <Grid Grid.Row="3"
                          Margin="12,2,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="WorkspaceDocumentStatus"
                                   Opacity="0.65"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="WorkspaceDocumentLineStatus"
                                   Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Opacity="0.65" />
                    </Grid>
                </Grid>
                <Thumb x:Name="WorkspaceDocumentDivider"
                       Grid.Column="1"
                       Width="6"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Stretch"
                       Canvas.ZIndex="1"
                       Background="Transparent"
                       AutomationProperties.Name="Resize document"
                       DragDelta="_WorkspaceDocumentDividerDragDelta"
                       DragCompleted="_WorkspaceDividerDragCompleted"
                       PointerEntered="_WorkspaceDividerPointerEntered"
                       PointerExited="_WorkspaceDividerPointerExited"
                       Visibility="Collapsed">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="{TemplateBinding Background}">
                                <Border Width="1"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>

            <Thumb x:Name="WorkspaceFilesDivider"
                   Grid.Column="2"
                   Width="6"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Stretch"
                   Canvas.ZIndex="2"
                   Background="Transparent"
                   AutomationProperties.Name="Resize files"
                   DragDelta="_WorkspaceFilesDividerDragDelta"
                   DragCompleted="_WorkspaceDividerDragCompleted"
                   PointerEntered="_WorkspaceDividerPointerEntered"
                   PointerExited="_WorkspaceDividerPointerExited"
                   Visibility="Collapsed">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="{TemplateBinding Background}">
                            <Border Width="1"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!--
                The sidebar and the terminal meet without a gap. The resize
                handle is an invisible strip over the terminal's left padding,
                so it doesn't cover the session list's scroll bar. It needs a
                non-null background to receive pointer input.
            -->
            <Thumb x:Name="SideTabDivider"
                   Grid.Column="2"
                   Width="6"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Stretch"
                   Canvas.ZIndex="1"
                   Background="Transparent"
                   AutomationProperties.Name="Resize sidebar"
                   DragStarted="_SideTabDividerDragStarted"
                   DragDelta="_SideTabDividerDragDelta"
                   DragCompleted="_SideTabDividerDragCompleted"
                   PointerEntered="_SideTabDividerPointerEntered"
                   PointerExited="_SideTabDividerPointerExited"
                   Visibility="Collapsed">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>

        <!-- The workspace page is the welcome screen and the navigation surface. -->
        <Grid x:Name="WorkspaceHub"
              Grid.Row="2"
              Canvas.ZIndex="3"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760"
                            Margin="36,48,36,36"
                            HorizontalAlignment="Center">
                    <TextBlock x:Uid="WorkspaceHubTitle"
                               FontSize="30"
                               FontWeight="SemiBold" />
                    <TextBlock x:Uid="WorkspaceHubDescription"
                               Margin="0,10,0,28"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="WorkspaceHubNewButton"
                                x:Uid="WorkspaceHubNewButton"
                                Click="_WorkspaceHubNewClick" />
                        <Button x:Name="WorkspaceHubFolderButton"
                                x:Uid="WorkspaceHubFolderButton"
                                Margin="10,0,0,0"
                                Click="_WorkspaceHubFolderClick" />
                        <Button x:Name="WorkspaceHubPathButton"
                                x:Uid="WorkspaceHubPathButton"
                                Margin="10,0,0,0"
                                Click="_WorkspaceHubPathClick" />
                    </StackPanel>
                    <TextBlock x:Uid="WorkspaceHubListHeader"
                               Margin="0,36,0,12"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <ListView x:Name="WorkspaceHubList"
                              MinWidth="480"
                              MaxHeight="360"
                              SelectionMode="Single"
                              SelectionChanged="_WorkspaceHubSelectionChanged" />
                    <TextBlock x:Name="WorkspaceHubEmptyText"
                               x:Uid="WorkspaceHubEmptyText"
                               Margin="0,12,0,0"
                               Visibility="Collapsed" />
                    <Button x:Name="WorkspaceHubBackButton"
                            x:Uid="WorkspaceHubBackButton"
                            Margin="0,24,0,0"
                            Click="_WorkspaceHubBackClick" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--
            The compact toggle remains available above the sidebar, even when
            its layout column is collapsed. While the sidebar is open it sits
            flat in the sidebar's toolbar row; the card only shows while it
            floats over the terminal.
        -->
        <Grid x:Name="SideTabDock"
              Grid.RowSpan="3"
              Width="40"
              Height="40"
              Margin="8,6,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              PointerEntered="_SideTabDockPointerEntered"
              PointerExited="_SideTabDockPointerExited"
              Visibility="Collapsed">
            <Border x:Name="SideTabDockCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Translation="0,0,16">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
            </Border>
            <Button x:Name="SideTabDockButton"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    Click="_SideTabDockClick">
                <!--  E8A0/E89F are the OpenPane/ClosePane glyphs.  -->
                <FontIcon x:Name="SideTabDockIcon"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="18"
                          Glyph="&#xE8A0;" />
            </Button>
        </Grid>

        <!--
            GH#12775 et. al: After switching to ControlsV2, it seems that
            delay-loading a dialog causes the ContentDialog to be assigned a
            Height equal to its content size. If we DON'T assign the
            ContentDialog a Row, I believe it's assigned Row 0 by default. So,
            when the dialog gets opened, the dialog seemingly causes a giant
            hole to appear in the body of the app.
            
            Assigning all the dialogs to Row 2 (where the rest of the content
            is) makes the "hole" appear in the same space as the rest of the
            TabContent, fixing the issue.
            
            Note that the actual content in a content dialog gets parented to
            the PopupRoot, so it actually always appeared in the correct place, it's
            just this weird hole that appeared in Row 0.
        -->

        <local:AboutDialog x:Name="AboutDialog"
                           Grid.Row="2"
                           x:Load="False" />

        <ContentDialog x:Name="ConfirmCloseDialog"
                       Grid.Row="2"
                       x:Load="False"
                       DefaultButton="Primary">
            <CheckBox x:Uid="DontAskAgainCheckBox" />
        </ContentDialog>

        <ContentDialog x:Name="CloseReadOnlyDialog"
                       x:Uid="CloseReadOnlyDialog"
                       Grid.Row="2"
                       x:Load="False"
                       DefaultButton="Close" />

        <ContentDialog x:Name="MultiLinePasteDialog"
                       x:Uid="MultiLinePasteDialog"
                       Grid.Row="2"
                       x:Load="False"
                       DefaultButton="Primary">
            <StackPanel>
                <TextBlock x:Uid="MultiLineWarningText"
                           TextWrapping="Wrap" />
                <TextBlock x:Uid="ClipboardTextHeader"
                           Margin="0,16,0,0" />
                <ScrollViewer x:Name="ClipboardContentScrollViewer"
                              MaxHeight="100"
                              Margin="0,8,0,0">
                    <TextBlock x:Name="ClipboardText"
                               FontFamily="Cascadia Mono"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="LargePasteDialog"
                       x:Uid="LargePasteDialog"
                       Grid.Row="2"
                       x:Load="False"
                       DefaultButton="Primary" />

        <ContentDialog x:Name="ControlNoticeDialog"
                       x:Uid="ControlNoticeDialog"
                       Grid.Row="2"
                       x:Load="False"
                       DefaultButton="Primary">
            <TextBlock IsTextSelectionEnabled="True"
                       TextWrapping="WrapWholeWords">
                <TextBlock.ContextFlyout>
                    <mtu:TextMenuFlyout />
                </TextBlock.ContextFlyout>
                <Run x:Name="NoticeMessage" />
            </TextBlock>
        </ContentDialog>

        <ContentDialog x:Name="UriErrorDialog"
                       x:Uid="UriErrorDialog"
                       Grid.Row="2"
                       x:Load="False"
                       DefaultButton="Close">
            <TextBlock IsTextSelectionEnabled="True"
                       TextWrapping="WrapWholeWords">
                <TextBlock.ContextFlyout>
                    <mtu:TextMenuFlyout />
                </TextBlock.ContextFlyout>
                <Run x:Name="CouldNotOpenUriReason" /> <LineBreak /> <LineBreak />
                <Run x:Name="UnopenedUri"
                     FontFamily="Cascadia Mono" />
            </TextBlock>
        </ContentDialog>

        <local:CommandPalette x:Name="CommandPaletteElement"
                              Grid.Row="2"
                              Canvas.ZIndex="4"
                              VerticalAlignment="Stretch"
                              x:Load="False"
                              PreviewKeyDown="_KeyDownHandler"
                              Visibility="Collapsed" />

        <local:SuggestionsControl x:Name="SuggestionsElement"
                                  Grid.Row="2"
                                  Canvas.ZIndex="4"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  x:Load="False"
                                  PreviewKeyDown="_KeyDownHandler"
                                  Visibility="Collapsed" />

        <!--
            A TeachingTip with IsLightDismissEnabled="True" will immediately
            dismiss itself if the window is unfocused (In Xaml Islands). This is
            tracked by MUX#4382
        -->
        <mux:TeachingTip x:Name="WindowIdToast"
                         Title="{x:Bind WindowProperties.WindowIdForDisplay}"
                         x:Load="False"
                         IsLightDismissEnabled="True"
                         Subtitle="{x:Bind WindowProperties.WindowNameForDisplay, Mode=OneWay}" />

        <mux:TeachingTip x:Name="WindowRenamer"
                         x:Uid="WindowRenamer"
                         Title="{x:Bind WindowProperties.WindowIdForDisplay}"
                         x:Load="False"
                         ActionButtonClick="_WindowRenamerActionClick"
                         ActionButtonStyle="{ThemeResource AccentButtonStyle}"
                         IsLightDismissEnabled="True">
            <mux:TeachingTip.Content>
                <TextBox x:Name="WindowRenamerTextBox"
                         KeyDown="_WindowRenamerKeyDown"
                         KeyUp="_WindowRenamerKeyUp"
                         Text="{x:Bind WindowProperties.WindowName, Mode=OneWay}">
                    <TextBox.ContextFlyout>
                        <mtu:TextMenuFlyout />
                    </TextBox.ContextFlyout>
                </TextBox>
            </mux:TeachingTip.Content>
        </mux:TeachingTip>

        <mux:TeachingTip x:Name="WindowCwdToast"
                         x:Uid="WindowCwdToast"
                         Title="{x:Bind WindowProperties.VirtualWorkingDirectory, Mode=OneWay}"
                         x:Load="False"
                         IsLightDismissEnabled="True" />

        <mux:TeachingTip x:Name="ActionSavedToast"
                         x:Uid="ActionSavedToast"
                         Title="Action Saved"
                         HorizontalAlignment="Stretch"
                         x:Load="False"
                         IsLightDismissEnabled="True">
            <mux:TeachingTip.Content>
                <StackPanel HorizontalAlignment="Stretch"
                            Orientation="Vertical">
                    <TextBlock x:Name="ActionSavedNameText"
                               Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(SavedActionName), Mode=OneWay}">
                        <Run Text="Name: " />
                        <Run Text="{x:Bind SavedActionName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock x:Name="ActionSavedKeyChordText"
                               Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(SavedActionKeyChord), Mode=OneWay}">
                        <Run Text="Key Chord: " />
                        <Run Text="{x:Bind SavedActionKeyChord, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock x:Name="ActionSavedCommandLineText"
                               Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(SavedActionCommandLine), Mode=OneWay}">
                        <Run Text="Input: " />
                        <Run Text="{x:Bind SavedActionCommandLine, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </mux:TeachingTip.Content>
        </mux:TeachingTip>
        <mux:TeachingTip x:Name="ActionSaveFailedToast"
                         x:Uid="ActionSaveFailedToast"
                         Title="Action Save Failed"
                         x:Load="False"
                         IsLightDismissEnabled="True">
            <mux:TeachingTip.Content>
                <TextBlock x:Name="ActionSaveFailedMessage"
                           Text="" />
            </mux:TeachingTip.Content>
        </mux:TeachingTip>
    </Grid>
</Page>
